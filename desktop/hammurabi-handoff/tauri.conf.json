{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hammurabi Handoff",
  "version": "0.1.0",
  "identifier": "com.hammurabi.handoff",
  "build": {
    "frontendDist": "ui/dist",
    "features": ["tauri-app"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hammurabi Handoff — RAMesh #handoff-ops",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc:"
    }
  },
  "bundle": {
    "active": false
  }
}
